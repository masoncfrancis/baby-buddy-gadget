# ==========================================
# BABY BUDDY PICO W LOGGER - CONFIG TEMPLATE
# ==========================================

# --- Network Configuration (Spaces in SSID are fully supported) ---
WIFI_SSID=Your Home Wi-Fi Name
WIFI_PASSWORD=your_wifi_password_here

# --- Baby Buddy API Configuration ---
# Do not include a trailing slash on the URL
BABY_BUDDY_BASE_URL=http://192.168.1.100:8000
CHILD_ID=3
CHILD_SLUG=your-child-slug
# Fixed offset from UTC, in minutes. Example: Eastern Standard Time = -300.
TIMEZONE_OFFSET_MINUTES=0

# --- Parent 1 Configuration ---
PARENT_1_NAME=Mike
PARENT_1_TOKEN=your_parent_1_api_token_here
PARENT_1_TAG=your_parent_1_tag_here

# --- Parent 2 Configuration ---
PARENT_2_NAME=Anne
PARENT_2_TOKEN=your_parent_2_api_token_here
PARENT_2_TAG=your_parent_2_tag_here
